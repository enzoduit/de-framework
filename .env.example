# Digital Employees Framework — Environment Variables
# Copy this file to .env and fill in your values.
# Load with: source .env  (or use python-dotenv / direnv)

# ── Anthropic ───────────────────────────────────────────────────────────────
# Required. Used by the ReAct engine to call Claude.
ANTHROPIC_API_KEY=sk-ant-...

# ── Model ────────────────────────────────────────────────────────────────────
# Model used for all DE sessions. Each DE can override this in de.json
# via a "model" field. Haiku is fast and cheap for routine agent work.
# Options: claude-haiku-4-5, claude-sonnet-4-5, claude-opus-4-5
DE_MODEL=claude-haiku-4-5

# ── API Server ──────────────────────────────────────────────────────────────
# Port the backend API listens on
DE_API_PORT=8766

# Auth token — the portal and Cloudflare Functions send this in Authorization: Bearer <token>
# Generate a strong random token: openssl rand -hex 24
DE_API_TOKEN=your-auth-token-here

# ── File Paths ───────────────────────────────────────────────────────────────
# Root directory containing all DE agent folders (cfo/, ops/, growth/, etc.)
# Each subfolder must contain de.json and job.md.
AGENTS_DIR=/opt/de-framework/agents

# ── Decisions API ────────────────────────────────────────────────────────────
# URL of the decisions ingest endpoint for human-in-loop notifications.
# When a DE requests a Level 2 decision, it POSTs to <DECISIONS_API_URL>/ingest.
# Leave blank to skip HTTP notification — decisions are always written to disk.
DECISIONS_API_URL=https://decisions.yourdomain.com

# ── Max Iterations ───────────────────────────────────────────────────────────
# Default ReAct loop iterations per session. Can also be set per-agent in de.json
# via "max_iterations". Higher = more thorough but more expensive.
DE_MAX_ITERATIONS=8

# ── Digital Employee Names ───────────────────────────────────────────────────
# Comma-separated list of DE names to show in the portal.
# Leave blank to auto-discover by scanning AGENTS_DIR for de.json files.
# DE_NAMES=cfo,ops,growth

# ── Telegram Notifications ──────────────────────────────────────────────────
# Optional. Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID to send notifications to (get from @userinfobot or API)
TELEGRAM_NOTIFY_CHAT_ID=

# ── ElevenLabs Voice Agent ───────────────────────────────────────────────────
# Optional. Agent ID from ElevenLabs Conversational AI.
ELEVENLABS_AGENT_ID=

# ElevenLabs API key (for voice prompt updates)
ELEVENLABS_API_KEY=

# ── Cloudflare Pages Functions ──────────────────────────────────────────────
# The portal's Cloudflare Functions also need these as secrets.
# Set in Cloudflare dashboard → Pages → Settings → Environment Variables:
#   DE_API_TOKEN    (same value as above)
#   DE_API_URL      (e.g. https://decisions.yourdomain.com)
